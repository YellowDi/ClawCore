{
  "name": "@clawcore/openclaw-clawbridge",
  "version": "0.1.0",
  "private": true,
  "description": "OpenClaw channel plugin for the ClawPro IM ClawBridge transport",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./api.js": "./dist/api.js",
    "./setup-entry.js": "./dist/setup-entry.js"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "openclaw": "2026.4.23"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "openclaw": "2026.4.23",
    "typescript": "^5.9.3"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./src/setup-entry.ts",
    "runtimeSetupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "clawbridge",
      "label": "ClawBridge",
      "selectionLabel": "ClawBridge",
      "detailLabel": "ClawPro IM Channel",
      "docsPath": "/channels/clawbridge",
      "docsLabel": "clawbridge",
      "blurb": "ClawPro IM channel over ClawCore serverUrl/wsUrl.",
      "systemImage": "bubble.left.and.bubble.right",
      "markdownCapable": true,
      "preferSessionLookupForAnnounceTarget": true,
      "order": 90
    }
  }
}
