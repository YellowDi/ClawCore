{
  "id": "clawbridge",
  "name": "ClawBridge",
  "description": "Connects OpenClaw to ClawPro IM and ClawBridge through a native channel.",
  "version": "0.1.0",
  "channels": [
    "clawbridge"
  ],
  "channelConfigs": {
    "clawbridge": {
      "label": "ClawBridge",
      "description": "ClawCore WebSocket bridge for ClawPro custom channels.",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "serverUrl": {
            "type": "string",
            "format": "uri"
          },
          "wsUrl": {
            "type": "string",
            "format": "uri"
          },
          "token": {
            "type": "string"
          },
          "agentId": {
            "type": "string"
          },
          "defaultTo": {
            "type": "string"
          },
          "allowFrom": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reconnectMs": {
            "type": "integer",
            "minimum": 100,
            "maximum": 60000
          },
          "accounts": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "serverUrl": {
                  "type": "string",
                  "format": "uri"
                },
                "wsUrl": {
                  "type": "string",
                  "format": "uri"
                },
                "token": {
                  "type": "string"
                },
                "agentId": {
                  "type": "string"
                },
                "defaultTo": {
                  "type": "string"
                },
                "allowFrom": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "reconnectMs": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 60000
                }
              }
            }
          },
          "defaultAccount": {
            "type": "string"
          }
        }
      },
      "uiHints": {
        "serverUrl": {
          "label": "IM Server URL",
          "placeholder": "https://example.com"
        },
        "wsUrl": {
          "label": "IM WebSocket URL",
          "placeholder": "wss://example.com/ws/channel"
        },
        "token": {
          "label": "User token",
          "sensitive": true
        }
      }
    }
  }
}
